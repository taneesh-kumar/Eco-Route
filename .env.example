# ==============================================================================
# EcoRoute Root Environment Configuration Reference (.env.example)
# Copy this file to .env or configure in your deployment platform (Vercel, Render, Railway, AWS ECS)
# NEVER commit real secret credentials or API tokens into git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# PostgreSQL / Supabase connection (asyncpg async driver required)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-supabase-id.supabase.co:5432/postgres

# Redis Connection (Upstash Redis or self-hosted)
# Format: redis://default:<password>@<host>:<port>/0 or rediss:// for TLS
REDIS_URL=rediss://default:your-redis-password@your-upstash-host.upstash.io:6379/0

# Allowed CORS Origins (JSON list of string URLs)
CORS_ORIGINS=["http://localhost:3000","https://ecoroute.vercel.app"]

# Electricity Maps API Configuration
# Get your API token from: https://api-portal.electricitymaps.com/
ELECTRICITY_MAPS_API_KEY=your_electricity_maps_api_key_here
ELECTRICITY_MAPS_API_URL=https://api.electricitymap.org/v4

# Carbon Deferral Optimization Parameters (Optional tuning)
CARBON_CACHE_MAX_AGE_SECONDS=300
CARBON_FORECAST_CACHE_MAX_AGE_SECONDS=1800
CARBON_DEFERRAL_MIN_RELATIVE_IMPROVEMENT=0.15
CARBON_DEFERRAL_EPSILON=0.0

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
# Public API URL used by client-side and SSR fetch calls to reach the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000
