ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database (Supabase PostgreSQL / asyncpg connection string)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=

# Redis (Cache, locks, and queues)
# Format: redis://<host>:<port>/<db> or rediss:// for SSL
REDIS_URL=

# CORS Allowed Origins (JSON array of strings)
CORS_ORIGINS=["http://localhost:3000"]

# Electricity Maps API
# Provide your auth token from https://api-portal.electricitymaps.com/
ELECTRICITY_MAPS_API_KEY=
ELECTRICITY_MAPS_API_URL=https://api.electricitymap.org/v3
